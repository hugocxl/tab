#!/bin/bash
# Fold auto-generated CHANGELOG.md into HEAD and create annotated tag vX.Y.Z.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
[ -f "$ROOT/CHANGELOG.md" ] || exit 0
[ "${NO_AUTO_TAG:-0}" != 1 ] || exit 0

WORK_VER="$(sed -n 's/^## \([0-9][0-9.]*\) - .*/\1/p' "$ROOT/CHANGELOG.md" | head -1)"
[ -n "$WORK_VER" ] || exit 0
HEAD_VER="$({ git -C "$ROOT" show HEAD:CHANGELOG.md 2>/dev/null || true; } | sed -n 's/^## \([0-9][0-9.]*\) - .*/\1/p' | head -1)"

if [ "$WORK_VER" != "$HEAD_VER" ]; then
    git -C "$ROOT" add CHANGELOG.md
    NO_AUTO_CHANGELOG=1 NO_AUTO_TAG=1 git -C "$ROOT" commit --amend --no-edit --no-verify --quiet
fi

TAG="v$WORK_VER"
git -C "$ROOT" rev-parse --verify --quiet "refs/tags/$TAG" > /dev/null && exit 0
NAME="$(basename "$ROOT")"
git -C "$ROOT" tag -a "$TAG" -m "$NAME $WORK_VER" HEAD
echo "Tagged $TAG"
